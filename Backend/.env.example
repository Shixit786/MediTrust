# Server Environment & Port
NODE_ENV=development
PORT=5000

# Database Connection (Optional: if empty/missing, runs gracefully without DB)
MONGODB_URI=mongodb://localhost:27017/meditrust

# Client Origins for CORS (comma-separated list)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# Demo Mode (true/false)
DEMO_MODE=false

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# Upstream Audio Service
AUDIO_SERVICE_URL=http://localhost:8000
AUDIO_SERVICE_TIMEOUT_MS=25000

# Optional External API Keys & LLM Config (Leave blank if not configured)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
LLM_TIMEOUT_MS=10000
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
ABUSEIPDB_API_KEY=
SECURITYTRAILS_API_KEY=
IPQS_API_KEY=
INTEL_TIMEOUT_MS=4000
INTEL_MAX_URLS=3
INTEL_CACHE_TTL_MS=1800000

# Company Verification Configuration
OPENCORPORATES_API_TOKEN=
COMPANY_TIMEOUT_MS=4000
COMPANY_CACHE_TTL_MS=3600000
